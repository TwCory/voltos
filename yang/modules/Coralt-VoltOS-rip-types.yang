module Coralt-VoltOS-rip-types {

    typedef rip-metric-type {
        type uint8 {
            range "1..15";
        }
    }

    typedef rip-offset-list-id-type {
        type union {
            type uint16 {
                range "1..199";
            }
            type uint16 {
                range "1300..2699";
            }
        }
    }

    typedef rip-offset-list-direction-type {
        type enumeration {
            enum in;
            enum out;
        }
    }
}